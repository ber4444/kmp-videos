# Copy to `secrets.properties` (gitignored) and fill in.
# Every value is optional: an empty key degrades the matching feature gracefully
# rather than failing the build.

# Streaming ASR for live captions. Empty → the caption clients surface a
# "missing key" error. Soniox is the app's preferred provider (see eval/).
DEEPGRAM_API_KEY=
SONIOX_API_KEY=

# Discord / Apollo gate. Neither value is a secret — the client id is public by
# design and the guild id is a snowflake — but they live here so a fork points at
# its own Discord application. Empty DISCORD_CLIENT_ID disables the gate.
DISCORD_CLIENT_ID=
# Empty → falls back to matching the guild *name* "Apollo", which is convenient
# for a first run but not unique on Discord.
APOLLO_GUILD_ID=
